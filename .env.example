# Variables de entorno

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Clave de localStorage donde se guarda el token de sesión
NEXT_PUBLIC_TOKEN_KEY=taskflow_token

# Cookie que indica al proxy (proxy.ts) que hay sesión iniciada
NEXT_PUBLIC_SESSION_FLAG_COOKIE=tf_has_session

# Tiempo máximo de espera de cada petición a la API, en milisegundos
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=15000

# Filas por página en los listados
NEXT_PUBLIC_PAGE_SIZE=8

# Responsable del tratamiento de datos (Ley 29733): aparece en Contacto y en las políticas.
# El correo debe ser el mismo buzón que CONTACT_EMAIL en el backend.
NEXT_PUBLIC_LEGAL_OWNER="PENDIENTE: tu nombre completo"
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=PENDIENTE@lubot.men
NEXT_PUBLIC_LEGAL_ANPD_REGISTRATION="PENDIENTE: código de inscripción ante la ANPD"
NEXT_PUBLIC_LEGAL_COMPANY="PENDIENTE: nombre de la empresa"

# Duración de la cookie de sesión, en minutos. Igual que SANCTUM_TOKEN_EXPIRATION del backend.
NEXT_PUBLIC_SESSION_MAX_AGE_MINUTES=43200

# Remitente de los correos. Igual que MAIL_FROM_ADDRESS del backend.
NEXT_PUBLIC_MAIL_FROM=noreply@lubot.men

# Redes sociales del pie de página (vacía = no se muestra)
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/Crypt0xDev
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/crypt0xdev
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/crypt0xdev
NEXT_PUBLIC_SOCIAL_X=https://x.com/Crypt0xDev
